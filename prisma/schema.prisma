generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  phoneNumber  String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  barber       Barber?
  customer     Customer?
}

model Customer {
  id               String        @id @default(uuid())
  userId           String        @unique
  favoriteBarberId String?
  createdAt        DateTime      @default(now())
  appointments     Appointment[]
  favoriteBarber   Barber?       @relation("FavoriteBarber", fields: [favoriteBarberId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  queueEntries     QueueEntry[]
  reviews          Review[]
}

model Barber {
  id                String           @id @default(uuid())
  userId            String           @unique
  photoUrl          String?
  status            BarberStatus     @default(AVAILABLE)
  createdAt         DateTime         @default(now())
  appointments      Appointment[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacations         BarberVacation[]
  favoriteCustomers Customer[]       @relation("FavoriteBarber")
  queueEntries      QueueEntry[]
  reviews           Review[]
}

model BarberVacation {
  id        String   @id @default(uuid())
  barberId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

model Service {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?
  price               Decimal              @db.Decimal(10, 2)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointmentServices AppointmentService[]
}

model Appointment {
  id              String               @id @default(uuid())
  customerId      String
  barberId        String
  appointmentDate DateTime
  status          AppointmentStatus    @default(CONFIRMED)
  totalAmount     Decimal              @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  barber          Barber               @relation(fields: [barberId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  services        AppointmentService[]
  payments        Payment[]
  queueEntry      QueueEntry?
  review          Review?

  @@index([customerId])
  @@index([barberId])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model QueueEntry {
  id            String       @id @default(uuid())
  customerId    String
  barberId      String
  appointmentId String?      @unique
  queuePosition Int
  status        QueueStatus  @default(WAITING)
  joinedAt      DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  barber        Barber       @relation(fields: [barberId], references: [id])
  customer      Customer     @relation(fields: [customerId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String
  amount        Decimal       @db.Decimal(10, 2)
  paymentType   PaymentType
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(uuid())
  customerId    String
  barberId      String
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barber        Barber      @relation(fields: [barberId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
}

enum UserRole {
  ADMIN
  BARBER
  CUSTOMER
}

enum BarberStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
  VACATION
}

enum AppointmentStatus {
  CONFIRMED
  IN_QUEUE
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  FINAL
}

enum PaymentMethod {
  TELEBIRR
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
